<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
 android:background="@drawable/widget_panel" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="3dp" android:paddingBottom="4dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:text="桌面快记" android:textColor="#F5FFF8" android:textSize="11sp" android:textStyle="bold" android:maxLines="1"/>
  <TextView android:id="@+id/quick_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="今天未记" android:textColor="#B9F7D6" android:textSize="10sp" android:maxLines="1"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="horizontal">
  <TextView android:id="@+id/preset_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
   android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/widget_button" android:textColor="#173D31" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="8 h"/>
  <TextView android:id="@+id/preset_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
   android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/widget_button" android:textColor="#173D31" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="10 h"/>
  <TextView android:id="@+id/preset_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
   android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/widget_button" android:textColor="#173D31" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="12 h"/>
  <TextView android:id="@+id/clock_out" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4"
   android:gravity="center" android:background="@drawable/widget_chip" android:textColor="#CAFFD9"
   android:textSize="11sp" android:textStyle="bold" android:includeFontPadding="false" android:maxLines="1" android:text="一键下班"/>
 </LinearLayout>
</LinearLayout>
